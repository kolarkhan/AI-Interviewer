{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: run server",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m uvicorn app.asgi:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Voice demo",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe tools/voice_poc.py --tone --turns 2 --interrupt-after 0.5",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Backend: run tests",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
