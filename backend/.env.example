# Copy to `.env` and fill in. NEVER commit `.env`. Placeholders only.

ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
# Only for web dashboards. Mobile apps do not need CORS. Never use * in production.
CORS_ORIGINS=

# MongoDB. `memory://` = in-process mock (dev/demo only, data lost on restart).
# Production example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_URL=memory://
DATABASE_NAME=ai_interviewer

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# OpenAI. Leave empty to run the clearly-labeled DEMO interviewer (no AI).
OPENAI_API_KEY=

# Voice engine: live = GPT-Live (gpt-live-1, voices Gleam/Meridian/Vesper/...), realtime = Realtime API
OPENAI_VOICE_ENGINE=live
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_DELEGATION_MODEL=gpt-5.6-luna         # Responses backend GPT-Live delegates reasoning to
OPENAI_REALTIME_MODEL=gpt-realtime-2.1            # premium plan (realtime engine)
OPENAI_REALTIME_MODEL_FREE=gpt-realtime-2.1-mini   # free plan (lower cost)
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REPORT_MODEL_BASIC=gpt-6-luna
OPENAI_REPORT_MODEL_DETAILED=gpt-6.1-sol
ALLOW_DEMO_MODE=true

# Direct client connections via ephemeral client secrets (off: the relay is the supported transport)
ENABLE_DIRECT_REALTIME=false
DIRECT_REALTIME_SECRET_TTL_SECONDS=120

LIVE_RECONNECT_GRACE_SECONDS=30
LIVE_WRAPUP_GRACE_SECONDS=45
TRANSCRIPT_RETENTION_DAYS=90
# Pre-generate voice preview samples at startup so the first play is instant
VOICE_PREVIEW_WARMUP=true
