/* AI Interviewer — design tokens and components (UI Toolkit USS).
   Units are "points" against a 390 x 844 reference resolution (PanelSettings scale-with-screen). */

:root {
    --bg: #0B1120;
    --bg-elevated: #10182B;
    --surface: #161F35;
    --surface-2: #1C2742;
    --surface-3: #24314F;
    --border: #2A3757;
    --text: #F3F6FC;
    --text-secondary: #AAB5CD;
    --text-muted: #6F7C98;
    --accent: #5B8CFF;
    --accent-pressed: #4775E6;
    --accent-2: #8B6CFF;
    --accent-soft: rgba(91, 140, 255, 0.16);
    --success: #34D399;
    --success-soft: rgba(52, 211, 153, 0.15);
    --warning: #FBBF24;
    --warning-soft: rgba(251, 191, 36, 0.14);
    --danger: #F87171;
    --danger-strong: #EF4444;
    --danger-soft: rgba(248, 113, 113, 0.15);
    --gold: #F5C76B;
    --gold-soft: rgba(245, 199, 107, 0.14);
    --radius-lg: 20px;
    --radius-md: 14px;
    --radius-sm: 10px;

    color: var(--text);
    font-size: 15px;
    /* No background here: the root must stay transparent so the 3D interview room shows through.
       Opaque backgrounds are set per screen (.screen). */
}

/* ---------- Layout ---------- */
.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.row { flex-direction: row; align-items: center; }
.row--wrap { flex-wrap: wrap; }
.col { flex-direction: column; }
.grow { flex-grow: 1; }
.center { align-items: center; justify-content: center; }
.space-between { justify-content: space-between; }
.hidden { display: none; }

.screen {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--bg);
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.28s, 0.28s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}
.screen--transparent { background-color: rgba(0, 0, 0, 0); }
.screen--enter { opacity: 0; translate: 28px 0; }
.screen--enter-up { opacity: 0; translate: 0 36px; }
.screen--enter-fade { opacity: 0; }
.screen--exit { opacity: 0; translate: -18px 0; }

.screen-content { flex-grow: 1; padding-left: 20px; padding-right: 20px; }
.scroll { flex-grow: 1; }
.scroll .unity-scroll-view__content-container { padding-bottom: 32px; }

.top-bar { flex-direction: row; align-items: center; height: 52px; margin-bottom: 4px; }
.top-bar__title { flex-grow: 1; -unity-text-align: middle-center; font-size: 17px; -unity-font-style: bold; }
.top-bar__side { width: 44px; height: 44px; justify-content: center; align-items: center; }

/* ---------- Typography ---------- */
.display { font-size: 30px; -unity-font-style: bold; white-space: normal; letter-spacing: -0.3px; }
.title { font-size: 24px; -unity-font-style: bold; white-space: normal; }
.h2 { font-size: 18px; -unity-font-style: bold; white-space: normal; }
.h3 { font-size: 15px; -unity-font-style: bold; white-space: normal; }
.body { font-size: 15px; color: var(--text-secondary); white-space: normal; }
.body--strong { color: var(--text); }
.caption { font-size: 12px; color: var(--text-muted); white-space: normal; }
.overline { font-size: 11px; color: var(--text-muted); -unity-font-style: bold; letter-spacing: 1.2px; }
.text-accent { color: var(--accent); }
.text-success { color: var(--success); }
.text-warning { color: var(--warning); }
.text-danger { color: var(--danger); }
.text-gold { color: var(--gold); }
.mono { letter-spacing: 1px; -unity-font-style: bold; }

.section-title { margin-top: 24px; margin-bottom: 10px; }

/* ---------- Surfaces ---------- */
.card {
    background-color: var(--surface);
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: var(--border);
    padding: 16px;
    margin-bottom: 12px;
}
.card--flat { border-width: 0; }
.card--accent { border-color: rgba(91, 140, 255, 0.45); background-color: #172345; }
.card--hero { border-width: 0; padding: 20px; overflow: hidden; }
.card--pressable { transition-property: scale, background-color; transition-duration: 0.12s, 0.12s; }
.card--pressable:active { scale: 0.985 0.985; background-color: var(--surface-2); }
.divider { height: 1px; background-color: var(--border); margin-top: 12px; margin-bottom: 12px; }

/* ---------- Buttons ---------- */
Button.btn {
    height: 52px;
    margin: 0;
    padding-left: 20px; padding-right: 20px;
    border-radius: var(--radius-md);
    border-width: 0;
    background-color: var(--accent);
    color: #FFFFFF;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    transition-property: scale, background-color, opacity;
    transition-duration: 0.1s, 0.15s, 0.15s;
}
Button.btn:hover { background-color: var(--accent); }
Button.btn:active { scale: 0.97 0.97; background-color: var(--accent-pressed); }
Button.btn:disabled { opacity: 0.45; }
Button.btn--secondary { background-color: var(--surface-2); color: var(--text); border-width: 1px; border-color: var(--border); }
Button.btn--secondary:hover { background-color: var(--surface-2); }
Button.btn--secondary:active { background-color: var(--surface-3); }
Button.btn--ghost { background-color: rgba(0, 0, 0, 0); color: var(--accent); }
Button.btn--ghost:hover { background-color: rgba(0, 0, 0, 0); }
Button.btn--ghost:active { background-color: var(--accent-soft); }
Button.btn--danger { background-color: var(--danger-strong); }
Button.btn--danger:hover { background-color: var(--danger-strong); }
Button.btn--danger:active { background-color: #DC2626; }
Button.btn--gold { background-color: var(--gold); color: #1B1405; }
Button.btn--gold:hover { background-color: var(--gold); }
Button.btn--small { height: 38px; font-size: 14px; padding-left: 14px; padding-right: 14px; border-radius: var(--radius-sm); }
Button.btn--block { align-self: stretch; }
.btn__label { -unity-font-style: bold; }
.btn__icon { margin-right: 8px; }

Button.icon-btn {
    width: 44px; height: 44px; margin: 0; padding: 0;
    border-radius: 22px; border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center; align-items: center;
    transition-property: background-color, scale;
    transition-duration: 0.12s, 0.1s;
}
Button.icon-btn:hover { background-color: rgba(0, 0, 0, 0); }
Button.icon-btn:active { background-color: rgba(255, 255, 255, 0.08); scale: 0.94 0.94; }

/* Round call controls in the interview room */
Button.call-btn {
    width: 64px; height: 64px; margin: 0 12px; padding: 0;
    border-radius: 32px; border-width: 1px; border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(22, 31, 53, 0.86);
    justify-content: center; align-items: center;
    transition-property: background-color, scale; transition-duration: 0.15s, 0.1s;
}
Button.call-btn:hover { background-color: rgba(22, 31, 53, 0.86); }
Button.call-btn:active { scale: 0.93 0.93; }
Button.call-btn--active { background-color: #F3F6FC; }
Button.call-btn--active:hover { background-color: #F3F6FC; }
Button.call-btn--end { background-color: var(--danger-strong); border-width: 0; width: 72px; height: 72px; border-radius: 36px; }
Button.call-btn--end:hover { background-color: var(--danger-strong); }
.call-btn__caption { font-size: 11px; color: var(--text-secondary); margin-top: 6px; -unity-text-align: middle-center; }

/* ---------- Inputs ---------- */
.field { margin-bottom: 14px; }
.field__label { font-size: 13px; color: var(--text-secondary); margin-bottom: 6px; -unity-font-style: bold; }
.field__error { font-size: 12px; color: var(--danger); margin-top: 6px; white-space: normal; }
TextField.input { margin: 0; }
TextField.input .unity-base-text-field__input,
TextField.input .unity-text-field__input {
    height: 50px;
    padding-left: 14px; padding-right: 14px;
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--bg-elevated);
    color: var(--text);
    font-size: 16px;
    -unity-text-align: middle-left;
}
TextField.input:focus .unity-base-text-field__input,
TextField.input:focus .unity-text-field__input { border-color: var(--accent); }
TextField.input--error .unity-base-text-field__input,
TextField.input--error .unity-text-field__input { border-color: var(--danger); }
TextField.input--multiline .unity-base-text-field__input,
TextField.input--multiline .unity-text-field__input { height: 160px; -unity-text-align: upper-left; white-space: normal; padding-top: 12px; }

/* ---------- Chips / segmented ---------- */
.chip {
    flex-direction: row; align-items: center;
    height: 40px; padding-left: 14px; padding-right: 14px;
    margin-right: 8px; margin-bottom: 8px;
    border-radius: 20px; border-width: 1px; border-color: var(--border);
    background-color: var(--surface);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s, 0.15s, 0.1s;
}
.chip:active { scale: 0.96 0.96; }
.chip__label { font-size: 14px; color: var(--text-secondary); }
.chip--selected { background-color: var(--accent-soft); border-color: var(--accent); }
.chip--selected .chip__label { color: var(--text); -unity-font-style: bold; }
.chip--locked { opacity: 0.6; }
.chip__icon { margin-right: 6px; }

.preview-btn { width: 36px; height: 36px; border-radius: 18px; flex-shrink: 0; align-items: center; justify-content: center; background-color: var(--accent-soft); border-width: 1px; border-color: rgba(91, 140, 255, 0.35); transition-property: scale, background-color; transition-duration: 0.1s, 0.15s; }
.preview-btn:active { scale: 0.92 0.92; }
.preview-btn--active { background-color: var(--accent); border-color: var(--accent); }
.select { flex-direction: row; align-items: center; min-height: 54px; padding: 10px 14px; border-radius: var(--radius-md); border-width: 1px; border-color: var(--border); background-color: var(--surface); transition-property: border-color, scale; transition-duration: 0.15s, 0.1s; }
.select:hover { border-color: var(--accent); }
.select:active { scale: 0.985 0.985; border-color: var(--accent); }
.select__body { flex-grow: 1; flex-shrink: 1; margin-right: 8px; }
.select__value { font-size: 15px; -unity-font-style: bold; white-space: normal; }
.select__caption { font-size: 12px; color: var(--text-muted); white-space: normal; margin-top: 2px; }
.option-card {
    flex-direction: row; align-items: center;
    padding: 14px; margin-bottom: 10px;
    border-radius: var(--radius-md); border-width: 1px; border-color: var(--border);
    background-color: var(--surface);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s, 0.15s, 0.1s;
}
.option-card:active { scale: 0.985 0.985; }
.option-card--selected { border-color: var(--accent); background-color: #172345; }
.option-card--locked { opacity: 0.6; }
.option-card__radio { width: 22px; height: 22px; border-radius: 11px; border-width: 2px; border-color: var(--text-muted); margin-right: 12px; justify-content: center; align-items: center; }
.option-card--selected .option-card__radio { border-color: var(--accent); }
.option-card__dot { width: 10px; height: 10px; border-radius: 5px; background-color: var(--accent); display: none; }
.option-card--selected .option-card__dot { display: flex; }

/* ---------- Badges / pills ---------- */
.badge { flex-direction: row; align-items: center; padding: 3px 9px; border-radius: 10px; background-color: var(--surface-3); align-self: flex-start; }
.badge__label { font-size: 11px; -unity-font-style: bold; color: var(--text-secondary); }
.badge--accent { background-color: var(--accent-soft); }
.badge--accent .badge__label { color: var(--accent); }
.badge--success { background-color: var(--success-soft); }
.badge--success .badge__label { color: var(--success); }
.badge--warning { background-color: var(--warning-soft); }
.badge--warning .badge__label { color: var(--warning); }
.badge--danger { background-color: var(--danger-soft); }
.badge--danger .badge__label { color: var(--danger); }
.badge--gold { background-color: var(--gold-soft); }
.badge--gold .badge__label { color: var(--gold); }

.banner { flex-direction: row; align-items: center; padding: 12px 14px; border-radius: var(--radius-md); margin-bottom: 12px; }
.banner--info { background-color: var(--accent-soft); }
.banner--warning { background-color: var(--warning-soft); }
.banner--danger { background-color: var(--danger-soft); }
.banner__text { flex-shrink: 1; flex-grow: 1; font-size: 13px; white-space: normal; color: var(--text); margin-left: 10px; }

.status-pill {
    flex-direction: row; align-items: center; align-self: center;
    padding: 9px 16px; border-radius: 22px;
    background-color: rgba(11, 17, 32, 0.78);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.08);
}
.status-pill__dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 8px; background-color: var(--text-muted); }
.status-pill__text { font-size: 14px; -unity-font-style: bold; }
.status-pill--speaking .status-pill__dot { background-color: var(--accent); }
.status-pill--listening .status-pill__dot { background-color: var(--success); }
.status-pill--thinking .status-pill__dot { background-color: var(--warning); }
.status-pill--offline .status-pill__dot { background-color: var(--danger); }

/* ---------- Lists ---------- */
.list-item {
    flex-direction: row; align-items: center;
    padding: 14px; margin-bottom: 8px;
    border-radius: var(--radius-md); background-color: var(--surface);
    border-width: 1px; border-color: var(--border);
    transition-property: background-color, scale; transition-duration: 0.12s, 0.1s;
}
.list-item:active { background-color: var(--surface-2); scale: 0.99 0.99; }
.list-item__icon { width: 40px; height: 40px; border-radius: 12px; background-color: var(--surface-3); justify-content: center; align-items: center; margin-right: 12px; }
.list-item__body { flex-grow: 1; flex-shrink: 1; }
.list-item__title { font-size: 15px; -unity-font-style: bold; white-space: normal; }
.list-item__subtitle { font-size: 12px; color: var(--text-muted); margin-top: 2px; white-space: normal; }
.list-item__trailing { margin-left: 8px; align-items: flex-end; }

.settings-group { background-color: var(--surface); border-radius: var(--radius-lg); border-width: 1px; border-color: var(--border); margin-bottom: 16px; overflow: hidden; }
.settings-row { flex-direction: row; align-items: center; min-height: 56px; padding: 10px 16px; border-bottom-width: 1px; border-color: var(--border); }
.settings-row:active { background-color: var(--surface-2); }
.settings-row--last { border-bottom-width: 0; }
.settings-row__text { flex-grow: 1; flex-shrink: 1; margin-right: 12px; }
.settings-row__title { font-size: 15px; white-space: normal; }
.settings-row__subtitle { font-size: 12px; color: var(--text-muted); white-space: normal; margin-top: 2px; }
.settings-row--danger .settings-row__title { color: var(--danger); }

/* ---------- Switch ---------- */
.switch { width: 50px; height: 30px; border-radius: 15px; background-color: var(--surface-3); padding: 3px; transition-property: background-color; transition-duration: 0.18s; }
.switch__knob { width: 24px; height: 24px; border-radius: 12px; background-color: #FFFFFF; translate: 0 0; transition-property: translate; transition-duration: 0.18s; transition-timing-function: ease-out-cubic; }
.switch--on { background-color: var(--accent); }
.switch--on .switch__knob { translate: 20px 0; }

/* ---------- Progress ---------- */
.progress { height: 8px; border-radius: 4px; background-color: var(--surface-3); overflow: hidden; }
.progress__fill { height: 8px; border-radius: 4px; background-color: var(--accent); width: 0; transition-property: width; transition-duration: 0.6s; transition-timing-function: ease-out-cubic; }
.progress--success .progress__fill { background-color: var(--success); }
.progress--warning .progress__fill { background-color: var(--warning); }
.progress--danger .progress__fill { background-color: var(--danger); }
.progress--thin { height: 4px; border-radius: 2px; }
.progress--thin .progress__fill { height: 4px; border-radius: 2px; }

.dots { flex-direction: row; justify-content: center; }
.dot { width: 8px; height: 8px; border-radius: 4px; margin: 0 4px; background-color: var(--surface-3); transition-property: width, background-color; transition-duration: 0.25s, 0.25s; }
.dot--active { width: 24px; background-color: var(--accent); }

/* ---------- Tab bar ---------- */
.tab-bar {
    position: absolute; left: 0; right: 0; bottom: 0;
    flex-direction: row;
    background-color: rgba(16, 24, 43, 0.97);
    border-top-width: 1px; border-color: var(--border);
    padding-top: 8px;
    transition-property: translate, opacity; transition-duration: 0.25s, 0.25s;
}
.tab-bar--hidden { translate: 0 100px; opacity: 0; }
.tab { flex-grow: 1; align-items: center; justify-content: center; height: 52px; }
.tab__label { font-size: 11px; color: var(--text-muted); margin-top: 3px; }
.tab--active .tab__label { color: var(--text); -unity-font-style: bold; }

/* ---------- Overlay: toast, dialog, veil ---------- */
.toast-host { position: absolute; left: 16px; right: 16px; top: 0; align-items: center; }
.toast {
    flex-direction: row; align-items: center;
    padding: 12px 16px; border-radius: var(--radius-md);
    background-color: #24314F; border-width: 1px; border-color: var(--border);
    opacity: 0; translate: 0 -20px;
    transition-property: opacity, translate; transition-duration: 0.25s, 0.25s; transition-timing-function: ease-out-cubic, ease-out-cubic;
}
.toast--visible { opacity: 1; translate: 0 0; }
.toast__text { font-size: 14px; white-space: normal; flex-shrink: 1; margin-left: 8px; }

.scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(3, 6, 14, 0.72); opacity: 0; transition-property: opacity; transition-duration: 0.2s; justify-content: center; align-items: center; padding: 24px; }
.scrim--visible { opacity: 1; }
.scrim--sheet { justify-content: flex-end; align-items: stretch; padding: 0; }
.sheet { background-color: var(--surface); border-top-left-radius: 24px; border-top-right-radius: 24px; border-top-width: 1px; border-color: var(--border); padding: 8px 16px 16px 16px; translate: 0 60px; transition-property: translate; transition-duration: 0.22s; transition-timing-function: ease-out-cubic; }
.scrim--visible .sheet { translate: 0 0; }
.sheet__handle { width: 40px; height: 4px; border-radius: 2px; background-color: var(--border); align-self: center; margin-bottom: 6px; }
.sheet__header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 6px; }
.sheet__list .unity-scroll-view__content-container { padding-bottom: 4px; }
.sheet-option { flex-direction: row; align-items: center; padding: 12px 14px; margin-bottom: 6px; border-radius: var(--radius-md); border-width: 1px; border-color: rgba(0, 0, 0, 0); }
.sheet-option:active { background-color: var(--surface-2); }
.sheet-option--selected { background-color: var(--accent-soft); border-color: var(--accent); }
.sheet-option--locked { opacity: 0.6; }
.sheet-option__body { flex-grow: 1; flex-shrink: 1; margin-right: 10px; }
.sheet-option__title { font-size: 15px; -unity-font-style: bold; white-space: normal; }
.dialog { width: 100%; max-width: 380px; background-color: var(--surface); border-radius: 24px; padding: 22px; border-width: 1px; border-color: var(--border); scale: 0.94 0.94; transition-property: scale; transition-duration: 0.2s; transition-timing-function: ease-out-back; }
.scrim--visible .dialog { scale: 1 1; }
.dialog__title { font-size: 19px; -unity-font-style: bold; white-space: normal; margin-bottom: 8px; }
.dialog__body { font-size: 15px; color: var(--text-secondary); white-space: normal; margin-bottom: 20px; }
.dialog__actions { flex-direction: column; }
.dialog__actions > Button { margin-top: 8px; }

/* ---------- Interview room HUD ---------- */
.hud-top { flex-direction: row; align-items: center; justify-content: space-between; padding: 8px 16px 0 16px; }
.hud-chip { flex-direction: row; align-items: center; padding: 7px 12px; border-radius: 16px; background-color: rgba(11, 17, 32, 0.72); }
.hud-chip__text { font-size: 13px; -unity-font-style: bold; margin-left: 6px; }
.hud-progress { margin: 8px 16px 0 16px; }
.hud-bottom { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 16px 16px 16px; }
.hud-gradient { position: absolute; left: 0; right: 0; bottom: 0; height: 320px; }
/* Fixed height: a ScrollView inside an auto-height parent collapses to 0 and hides every line. */
.transcript-panel { height: 180px; flex-shrink: 0; margin-bottom: 14px; padding: 12px 14px; border-radius: var(--radius-lg); background-color: rgba(11, 17, 32, 0.8); border-width: 1px; border-color: rgba(255, 255, 255, 0.07); }
.transcript-panel > .scroll { flex-grow: 1; flex-shrink: 1; }
.transcript-panel .unity-scroll-view__content-container { padding-bottom: 4px; }
.transcript-line { margin-bottom: 8px; }
.transcript-line__speaker { font-size: 11px; -unity-font-style: bold; color: var(--accent); margin-bottom: 2px; }
.transcript-line--candidate .transcript-line__speaker { color: var(--success); }
.transcript-line__text { font-size: 14px; white-space: normal; color: var(--text); }
.transcript-line--partial .transcript-line__text { color: var(--text-secondary); }
.controls { flex-direction: row; justify-content: center; align-items: flex-start; }
.control { align-items: center; }

/* ---------- Misc ---------- */
.logo-title { font-size: 26px; -unity-font-style: bold; margin-top: 18px; }
.tagline { font-size: 14px; color: var(--text-secondary); margin-top: 6px; }
.splash-fade { opacity: 0; transition-property: opacity, translate; transition-duration: 0.6s, 0.6s; translate: 0 12px; }
.splash-fade--in { opacity: 1; translate: 0 0; }
.metric { flex-grow: 1; flex-basis: 0; background-color: var(--surface); border-radius: var(--radius-md); border-width: 1px; border-color: var(--border); padding: 14px; margin-right: 10px; }
.metric--last { margin-right: 0; }
.metric__value { font-size: 22px; -unity-font-style: bold; }
.metric__label { font-size: 12px; color: var(--text-muted); margin-top: 2px; white-space: normal; }
.status-view { align-items: center; justify-content: center; padding: 32px 24px; }
.status-view__icon { width: 76px; height: 76px; border-radius: 38px; background-color: var(--surface-2); justify-content: center; align-items: center; margin-bottom: 18px; }
.status-view__title { font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; margin-bottom: 8px; }
.status-view__body { font-size: 15px; color: var(--text-secondary); -unity-text-align: middle-center; white-space: normal; margin-bottom: 20px; }
.skeleton { background-color: var(--surface-2); border-radius: var(--radius-md); opacity: 0.7; }
.bullet { flex-direction: row; align-items: flex-start; margin-bottom: 10px; }
.bullet__icon { margin-top: 1px; margin-right: 10px; }
.bullet__text { flex-shrink: 1; flex-grow: 1; font-size: 14px; color: var(--text); white-space: normal; }
.offline-banner { position: absolute; left: 0; right: 0; top: 0; flex-direction: row; justify-content: center; align-items: center; padding: 8px; background-color: var(--danger-strong); translate: 0 -60px; transition-property: translate; transition-duration: 0.25s; }
.offline-banner--visible { translate: 0 0; }
.offline-banner__text { font-size: 13px; -unity-font-style: bold; color: #FFFFFF; margin-left: 6px; }
